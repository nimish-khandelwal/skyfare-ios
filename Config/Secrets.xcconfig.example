// Copy this file to Config/Secrets.xcconfig and paste your test access token.
// Get one free at https://app.duffel.com/join -> Developers -> Access tokens.
// A test token starts with duffel_test_ and is shown only once.
// Config/Secrets.xcconfig is git-ignored and never committed.

DUFFEL_ACCESS_TOKEN = duffel_test_your_token_here
